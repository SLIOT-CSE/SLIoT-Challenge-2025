{
  "name": "sliot",
  "version": "0.0.0",
  "private": true,
  "description": "Official website of the SLIoT Challenge, Sri Lanka's national IoT competition.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SLIOT2026/SLIoT-Challenge-2025.git"
  },
  "license": "ISC",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "email:dev": "email dev --dir src/emails/preview --port 3200"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@node-rs/argon2": "^2.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-email/render": "^2.3.1",
    "@tanstack/react-table": "^9.3.1",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.12.5",
    "lenis": "^1.3.27",
    "lucide-react": "^0.447.0",
    "motion": "^14.14.0",
    "next": "^16.3.6",
    "nodemailer": "^10.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.16",
    "react-icons": "^5.4.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "jiti": "^2.7.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
