# Copy to .env.local (development) or the server's env file (production) and fill in.
# Never commit real values. Empty means unset. See src/server/env.ts.

# SQLite file. Development default: ./data/sliot.db. Production: /var/lib/sliot/sliot.db (required)
DATABASE_PATH=

# Public address of the site, for links in emails (required in production)
SITE_URL=

# Email through Google Workspace SMTP as sliot@cse.mrt.ac.lk (workload R1).
# Until these are set, emails wait in the outbox as "pending".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# The app password, not the account password
SMTP_PASSWORD=
EMAIL_FROM=

# Proposal uploads to the "SLIoT 2027 Proposals" Drive folder through OAuth (workload R3).
# Until these are set, proposal uploads fail with "Drive is not set up".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
