# /etc/sliot-backup/backup.env on the server: owner root, mode 600. Read by sliot-snapshot and
# sliot-restore as shell variables, so no spaces around "=" and quotes around anything unusual.
# No real values in Git.

# Must match DATABASE_PATH in the app's settings (/etc/sliot/sliot.env)
DATABASE_PATH=/var/lib/sliot/sliot.db

# The age PUBLIC key (starts with "age1"). The private key lives only in the password manager
AGE_RECIPIENT=

# Where snapshots go: <rclone remote>:<bucket>. The laptop rehearsal uses
# r2:sliot-backups/rehearsal so test files never mix with real ones
REMOTE=r2:sliot-backups
RCLONE_CONFIG=/etc/sliot-backup/rclone.conf

# Work files and the last pre-migration copies (root only: they contain personal data)
LOCAL_DIR=/var/backups/sliot
KEEP_LOCAL=10

# The healthchecks.io ping address. Empty = no pings (always empty for a rehearsal)
HEALTHCHECK_URL=
